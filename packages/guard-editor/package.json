{
  "name": "@prisma-query-builder/guard-editor",
  "private": true,
  "type": "module",
  "description": "Controlled guard-policy editing and a browser-safe policy core",
  "license": "MIT",
  "files": ["dist", "README.md"],
  "sideEffects": ["**/*.css", "**/*.svelte"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js" },
    "./types": { "types": "./dist/core/types.d.ts", "import": "./dist/core/types.js" },
    "./schema": { "types": "./dist/core/schema.d.ts", "import": "./dist/core/schema.js" },
    "./dmmf": { "types": "./dist/adapters/dmmf.d.ts", "import": "./dist/adapters/dmmf.js" },
    "./validation": { "types": "./dist/core/policy.d.ts", "import": "./dist/core/policy.js" },
    "./compiler": { "types": "./dist/core/compiler.d.ts", "import": "./dist/core/compiler.js" },
    "./svelte": { "types": "./dist/svelte/index.d.ts", "svelte": "./dist/svelte/index.js", "import": "./dist/svelte/index.js" }
  },
  "scripts": {
    "build:core": "tsc -p tsconfig.core.json",
    "build": "svelte-package -i src -o dist",
    "check:core": "tsc -p tsconfig.core.json --noEmit",
    "check": "npm run check:core && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:browser": "playwright test --config playwright.config.ts",
    "check:exports": "node scripts/check-exports.mjs",
    "test:prisma": "node --test --test-concurrency=1 test/prisma-contract/generate.test.mjs"
  },
  "peerDependencies": { "svelte": "^5.20.0" },
  "peerDependenciesMeta": { "svelte": { "optional": true } },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "svelte": "^5.48.2",
    "svelte-check": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": { "node": "^22.14.0 || ^24.10.0" }
}
