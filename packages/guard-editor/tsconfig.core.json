{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "exactOptionalPropertyTypes": true, "noImplicitOverride": true,
    "declaration": true, "rootDir": "src", "outDir": "dist", "lib": ["ES2022"],
